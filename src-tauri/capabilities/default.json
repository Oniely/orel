{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-is-maximized",
    "core:window:allow-unmaximize",
    "os:default"
  ]
}
